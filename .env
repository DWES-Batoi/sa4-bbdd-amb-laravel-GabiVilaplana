APP_NAME=FutbolFemeni
APP_ENV=local
APP_KEY=base64:d06pE74zkTDRl4Eyzlzq72kIksxJiCnDxhxU9OTO0Vw=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=ca
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Conexión Base de Datos
DB_CONNECTION=mysql
DB_HOST=futbol-db
DB_PORT=3306
DB_DATABASE=futbol
DB_USERNAME=futbol
DB_PASSWORD=futbol

# Configuración de Drivers (Cambiado a Redis para mejor rendimiento)
BROADCAST_CONNECTION=reverb
CACHE_STORE=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Configuración Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Google Auth (Socialite)
GOOGLE_CLIENT_ID=tu-id-de-cliente
GOOGLE_CLIENT_SECRET=tu-secreto-de-cliente
GOOGLE_REDIRECT=http://localhost:8000/auth/google/callback

# Configuración Reverb (Servidor)
REVERB_APP_ID=local
REVERB_APP_KEY=local
REVERB_APP_SECRET=local
REVERB_HOST="0.0.0.0"
REVERB_PORT=8081
REVERB_SCHEME=http

# Configuración Reverb (Navegador/Vite)
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="localhost"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# OLLAMA
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b